# AI provider: anthropic | openai | ollama | gemini (default: anthropic)
AI_PROVIDER=anthropic

# Optional: override models per provider
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o
# OLLAMA_MODEL=llama3.2
# GEMINI_MODEL=gemini-2.0-flash
#
# Legacy fallback when provider-specific model is not set:
# AI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (or any OpenAI-compatible API — set OPENAI_BASE_URL to override the endpoint)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional, for Groq / OpenRouter / LM Studio / etc.

# Ollama (local, no key required)
# OLLAMA_BASE_URL=http://localhost:11434       # optional, this is the default

# Gemini
# GEMINI_API_KEY=your-key-here
